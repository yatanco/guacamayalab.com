---
export interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <script>
      (function () {
        var stored = localStorage.getItem('theme');
        var theme = stored || (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', theme);
      })();
    </script>
  </head>
  <body>
    <div class="shell">
      <header class="shell-nav">
        <a class="shell-home" href="/">
          Guacamaya Lab
          <span class="wingstripe" aria-hidden="true"></span>
        </a>
        <div class="shell-controls">
          <nav>
            <a href="/">Projects</a>
            <span class="sep">/</span>
            <a href="https://yatan.co">Yatan</a>
          </nav>
          <button class="theme-toggle" data-theme-toggle type="button" aria-label="Toggle color theme">☾</button>
        </div>
      </header>
      <main>
        <slot />
      </main>
      <footer class="shell-footer">
        <a href="https://github.com/yatanco">GitHub</a>
        <span class="sep">·</span>
        <a href="https://linkedin.com/in/yatanblumenthal">LinkedIn</a>
        <span class="sep">·</span>
        <a href="https://instagram.com/yatan.co">Instagram</a>
        <span class="sep">·</span>
        <a href="https://x.com/yatanco">X</a>
      </footer>
    </div>
    <script>
      const btn = document.querySelector('[data-theme-toggle]');
      const icon = (t: string) => (t === 'light' ? '☀' : '☾');
      const label = (t: string) => (t === 'light' ? 'Switch to dark theme' : 'Switch to light theme');
      function sync() {
        const t = document.documentElement.getAttribute('data-theme') || 'dark';
        if (btn) {
          btn.textContent = icon(t);
          btn.setAttribute('aria-label', label(t));
        }
      }
      sync();
      btn?.addEventListener('click', () => {
        const next = (document.documentElement.getAttribute('data-theme') || 'dark') === 'light' ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('theme', next);
        sync();
      });
    </script>
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap');

  :root {
    --bg: #0a0a0a;
    --mono: 'JetBrains Mono', ui-monospace, monospace;
    --serif: 'Source Serif 4', Georgia, serif;
    --accent: #e8a23d;
    --text-primary: #f2f2f0;
    --text-dim: #8a8a86;
    --rule: #232323;
    --feather-gold: #e8a23d;
    --feather-scarlet: #d1573f;
    --feather-cobalt: #4f7ecb;
    --feather-green: #4f9e6e;
    --read-bg: #0a0a0a;
    --read-text: #e6e4df;
    --read-text-dim: #a3a19c;
    --read-accent: #e8a23d;
    --read-max-width: 68ch;
    --read-line-height: 1.75;
  }

  @media (prefers-color-scheme: light) {
    :root:not([data-theme]) {
      --bg: #faf9f6;
      --accent: #a1590f;
      --text-primary: #1c1c1a;
      --text-dim: #6b6b64;
      --rule: #e2e0da;
      --feather-gold: #a1590f;
      --feather-scarlet: #a1392a;
      --feather-cobalt: #2f568f;
      --feather-green: #2f7a50;
      --read-bg: #f6f1e7;
      --read-text: #2a241c;
      --read-text-dim: #736b5c;
      --read-accent: #a1590f;
    }
  }

  :root[data-theme='light'] {
    --bg: #faf9f6;
    --accent: #a1590f;
    --text-primary: #1c1c1a;
    --text-dim: #6b6b64;
    --rule: #e2e0da;
    --feather-gold: #a1590f;
    --feather-scarlet: #a1392a;
    --feather-cobalt: #2f568f;
    --feather-green: #2f7a50;
    --read-bg: #f6f1e7;
    --read-text: #2a241c;
    --read-text-dim: #736b5c;
    --read-accent: #a1590f;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    margin: 0;
    padding: 0;
    background: var(--bg);
    color: var(--text-primary);
  }

  body {
    font-family: var(--mono);
  }

  body,
  a,
  button,
  hr {
    transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease;
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  a:focus-visible,
  button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  hr {
    border: none;
    border-top: 1px solid var(--rule);
    margin: 2.5rem 0;
  }

  hr.wingstripe {
    height: 4px;
    border: none;
    margin: 2.5rem 0;
    background: linear-gradient(
      to right,
      var(--feather-gold) 0 25%,
      var(--feather-scarlet) 25% 50%,
      var(--feather-cobalt) 50% 75%,
      var(--feather-green) 75% 100%
    );
    opacity: 0.85;
  }

  @media (prefers-reduced-motion: reduce) {
    * {
      animation: none !important;
      transition: none !important;
    }
  }

  @media (max-width: 700px) {
    body {
      font-size: 15px;
    }
  }

  .shell {
    max-width: 760px;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
  }

  .shell-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 1px solid var(--rule);
    padding-bottom: 1.25rem;
    margin-bottom: 2.5rem;
    font-family: var(--mono);
  }

  .shell-home {
    position: relative;
    color: var(--text-primary);
    font-weight: 700;
    font-size: 0.95rem;
  }

  .shell-home:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .wingstripe {
    display: block;
    width: 28px;
    height: 3px;
    margin-top: 0.3rem;
    background: linear-gradient(
      to right,
      var(--feather-gold) 0 25%,
      var(--feather-scarlet) 25% 50%,
      var(--feather-cobalt) 50% 75%,
      var(--feather-green) 75% 100%
    );
  }

  .shell-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.9rem;
  }

  nav {
    font-size: 0.9rem;
    color: var(--text-dim);
  }

  nav a {
    color: var(--text-dim);
  }

  nav a:hover {
    color: var(--accent);
  }

  .sep {
    color: var(--rule);
    margin: 0 0.35rem;
  }

  .theme-toggle {
    background: none;
    border: none;
    padding: 0;
    line-height: 1;
    font-size: 1rem;
    color: var(--text-dim);
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--accent);
  }

  .shell-footer {
    margin-top: 4rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
    font-family: var(--mono);
    font-size: 0.85rem;
    color: var(--text-dim);
  }

  .shell-footer a {
    color: var(--text-dim);
  }

  .shell-footer a:hover {
    color: var(--accent);
  }

  @media (max-width: 700px) {
    .shell {
      padding: 2rem 1.25rem 3rem;
    }
  }
</style>
